# System Configuration
NODE_ENV=development
PORT_GATEWAY=4000
PORT_AUTH=4001
PORT_PAYMENT=4002
PORT_TRANSACTION=4003
PORT_MERCHANT=4004
PORT_REFUND=4005
PORT_FRAUD=4006
PORT_NOTIFICATION=4007
PORT_REPORTING=4008
PORT_MONITORING=4009

# Security & JWT
JWT_SECRET=super-secret-jwt-key-distributed-payment-system-2025
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-distributed-payment-system-2025
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration
# In development, an embedded high-performance SQL engine is used if Postgres is not configured.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_db
DB_TYPE=sqlite
DB_FILE=./payment_system.sqlite

# Redis & Message Broker (Optional / Fallback to In-Memory Event Bus)
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672

# Circuit Breaker & Retry Thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
